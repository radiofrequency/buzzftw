---
const base = import.meta.env.BASE_URL;
const home = base.endsWith("/") ? base : `${base}/`;
const launch = `${base}launch`.replace(/\/{2,}/g, "/").replace(":/", "://");
const dashboard = `${base}dashboard`.replace(/\/{2,}/g, "/").replace(":/", "://");
const isHome =
  Astro.url.pathname === home ||
  Astro.url.pathname === base ||
  Astro.url.pathname === "/";

const links = [
  { href: isHome ? "#top" : `${home}#top`, label: "Top" },
  { href: isHome ? "#new" : `${home}#new`, label: "New" },
  { href: isHome ? "#explore" : `${home}#explore`, label: "Explore" },
  { href: isHome ? "#how" : `${home}#how`, label: "How" },
  { href: dashboard, label: "Dashboard" },
];
---

<header class="nav">
  <div class="nav__inner wrap">
    <a class="nav__brand" href={isHome ? "#hero" : home} aria-label="BuzzFTW home">
      <img class="nav__mark" src={`${base}mark.svg`} width="32" height="32" alt="BuzzFTW" />
      <span class="nav__word">Buzz<span class="nav__ai">FTW</span></span>
    </a>

    <button
      class="nav__toggle"
      type="button"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Menu"
    >
      <span></span>
      <span></span>
    </button>

    <nav id="site-nav" class="nav__menu" data-nav-menu aria-label="Primary">
      {
        links.map((l) => (
          <a class="nav__link" href={l.href} data-nav-link>
            {l.label}
          </a>
        ))
      }
      <a class="nav__cta" href={launch} data-nav-link>
        Launch
      </a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--nav-h);
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--ghost);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    gap: var(--space-4);
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--ink);
  }

  .nav__brand:hover {
    color: var(--ink);
  }

  .nav__mark {
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
    object-fit: contain;
  }

  .nav__word {
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .nav__ai {
    font-weight: 400;
    color: var(--slate);
    letter-spacing: 0.14em;
  }

  .nav__menu {
    display: none;
    align-items: center;
    gap: var(--space-1);
  }

  .nav__link {
    padding: 0.4rem 0.7rem;
    font-size: var(--text-sm);
    color: var(--slate);
    text-decoration: none;
    letter-spacing: 0.02em;
    position: relative;
  }

  .nav__link::after {
    content: "";
    position: absolute;
    left: 0.7rem;
    right: 0.7rem;
    bottom: 0.15rem;
    height: 1px;
    background: var(--signal);
    opacity: 0;
    transform: scaleX(0.4);
    transition: opacity var(--duration) var(--ease), transform var(--duration) var(--ease);
  }

  .nav__link:hover,
  .nav__link.is-active {
    color: var(--ink);
  }

  .nav__link.is-active::after,
  .nav__link:hover::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .nav__cta {
    margin-left: 0.35rem;
    padding: 0.45rem 0.95rem;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--paper);
    text-decoration: none;
    background: var(--ink);
    border: 1px solid var(--ink);
    border-radius: 999px;
    letter-spacing: 0.02em;
    transition:
      background var(--duration) var(--ease),
      border-color var(--duration) var(--ease);
  }

  .nav__cta:hover {
    background: color-mix(in srgb, var(--ink) 88%, var(--honey));
    border-color: color-mix(in srgb, var(--ink) 88%, var(--honey));
    color: var(--paper);
  }

  .nav__toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .nav__toggle span {
    display: block;
    width: 1.1rem;
    height: 1px;
    margin-inline: auto;
    background: var(--ink);
    opacity: 0.55;
    transition: opacity var(--duration) var(--ease);
  }

  .nav__toggle:hover span {
    opacity: 1;
  }

  @media (max-width: 767px) {
    .nav__menu {
      position: absolute;
      top: var(--nav-h);
      left: 0;
      right: 0;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: var(--space-3) var(--space-6) var(--space-5);
      background: var(--paper);
      border-bottom: 1px solid var(--ghost);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-4px);
      transition:
        opacity var(--duration) var(--ease),
        transform var(--duration) var(--ease),
        visibility var(--duration);
    }

    .nav__menu.is-open {
      opacity: 1;
      visibility: visible;
      transform: none;
    }

    .nav__link {
      padding: 0.85rem 0;
      border-bottom: 1px solid var(--ghost);
    }

    .nav__link::after {
      display: none;
    }

    .nav__cta {
      margin: var(--space-4) 0 0;
      text-align: center;
      border-radius: 8px;
    }
  }

  @media (min-width: 768px) {
    .nav__toggle {
      display: none;
    }

    .nav__menu {
      display: flex;
    }
  }
</style>
