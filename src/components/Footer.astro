---
import { X_DM_URL, X_HANDLE } from "../lib/links";

const base = import.meta.env.BASE_URL;
---

<footer class="footer">
  <div class="wrap footer__inner">
    <div class="footer__brand">
      <img src={`${base}mark.svg`} width="24" height="24" alt="" />
      <span>BuzzFTW</span>
    </div>
    <nav class="footer__nav" aria-label="Footer">
      <a href={`${base}#explore`}>Explore</a>
      <a href={`${base}launch`}>Launch</a>
      <a href={`${base}dashboard`}>Dashboard</a>
      <a href="https://buzz.xyz" target="_blank" rel="noopener noreferrer">Buzz Desktop</a>
    </nav>
    <p class="footer__copy">BuzzFTW is a service of Folstad Consulting Inc.</p>
    <a class="footer__x" href={X_DM_URL} target="_blank" rel="noopener noreferrer">{X_HANDLE}</a>
  </div>
</footer>

<style>
  .footer {
    padding-block: var(--space-6);
    border-top: 1px solid var(--ghost);
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-6);
    justify-content: space-between;
  }

  .footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.1rem;
  }

  .footer__nav a {
    font-size: var(--text-xs);
    color: var(--slate);
    text-decoration: none;
    letter-spacing: 0.02em;
  }

  .footer__nav a:hover {
    color: var(--signal);
  }

  .footer__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-sm);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .footer__brand img {
    width: 1.5rem;
    height: 1.5rem;
    object-fit: contain;
  }

  .footer__copy {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--slate);
  }

  .footer__x {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--slate);
    text-decoration: none;
  }

  .footer__x:hover {
    color: var(--signal);
  }
</style>
