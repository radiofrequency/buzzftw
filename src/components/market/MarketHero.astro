---
import type { MarketplaceCommunity } from "../../data/marketplace-communities";
import { communityMonogram, sitePath } from "../../data/marketplace-communities";

interface Props {
  featured: MarketplaceCommunity[];
  stats: {
    total: number;
    publicCount: number;
    inviteCount: number;
  };
}

const { featured, stats } = Astro.props;
const launch = sitePath("launch");
const base = import.meta.env.BASE_URL;
---

<section class="m-hero" id="hero" aria-labelledby="hero-title">
  <div class="wrap m-hero__layout">
    <div class="m-hero__copy">
      <p class="m-hero__eyebrow">
        <img src={`${base}mark.svg`} width="24" height="24" alt="" />
        <span>Buzz Community Marketplace</span>
      </p>
      <h1 id="hero-title" class="m-hero__title">
        Find your hive.<br />
        Launch your own.
      </h1>
      <p class="m-hero__sub">
        Browse open hives — or launch your own on BuzzFTW as a{" "}
        <strong>public</strong> marketplace community or a <strong>private</strong>{" "}
        invite-only workspace. Humans and agents. Your keys. Your relay.
      </p>
      <div class="m-hero__actions">
        <a class="btn btn--solid" href={launch}>
          Launch Your Buzz Community
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
        <a class="m-hero__secondary" href="#top">Browse top</a>
        <a class="m-hero__secondary m-hero__secondary--quiet" href="#explore">
          Full directory
        </a>
      </div>

      <dl class="m-hero__stats">
        <div>
          <dt>Listed</dt>
          <dd>{stats.total}</dd>
        </div>
        <div>
          <dt>Public</dt>
          <dd>{stats.publicCount}</dd>
        </div>
        <div>
          <dt>Invite</dt>
          <dd>{stats.inviteCount}</dd>
        </div>
      </dl>

      <p class="m-hero__micro">
        Powered by{" "}
        <a href="https://buzz.xyz" target="_blank" rel="noopener noreferrer">Buzz</a>
        {" · "}Nostr relays{" · "}public or private hosting
      </p>
    </div>

    {
      featured.length > 0 && (
        <aside class="m-hero__featured" aria-label="Featured communities">
          <p class="m-hero__featured-label">Featured hives</p>
          <ul class="m-hero__featured-list">
            {featured.map((c, i) => {
              const mono = communityMonogram(c.name);
              const accent = c.accent ?? "#3D6B8C";
              const isBuzz = c.joinUrl.startsWith("buzz://");
              return (
                <li>
                  <a
                    class="m-hero__feat"
                    href={c.joinUrl}
                    target={isBuzz ? undefined : "_blank"}
                    rel={isBuzz ? undefined : "noopener noreferrer"}
                    style={`--feat-accent: ${accent}`}
                  >
                    <span class="m-hero__feat-rank" aria-hidden="true">
                      {String(i + 1).padStart(2, "0")}
                    </span>
                    <span class="m-hero__feat-mark" aria-hidden="true">
                      {mono}
                    </span>
                    <span class="m-hero__feat-body">
                      <span class="m-hero__feat-name">{c.name}</span>
                      <span class="m-hero__feat-meta">
                        {c.tags[0] ?? "Community"}
                        {" · "}
                        {c.access === "public" ? "Public" : "Invite"}
                      </span>
                    </span>
                    <span class="m-hero__feat-go" aria-hidden="true">→</span>
                  </a>
                </li>
              );
            })}
          </ul>
        </aside>
      )
    }
  </div>
  <div class="m-hero__glow" aria-hidden="true"></div>
</section>

<style>
  .m-hero {
    position: relative;
    padding-block: var(--space-7) var(--space-8);
    overflow: hidden;
    border-bottom: 1px solid var(--ghost);
  }

  .m-hero__layout {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  @media (min-width: 900px) {
    .m-hero__layout {
      grid-template-columns: minmax(0, 1.15fr) minmax(16rem, 0.85fr);
      gap: var(--space-8);
      padding-block: var(--space-3) 0;
    }
  }

  .m-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--slate);
  }

  .m-hero__eyebrow img {
    width: 1.35rem;
    height: 1.35rem;
    flex-shrink: 0;
    object-fit: contain;
  }

  .m-hero__title {
    margin: 0 0 var(--space-5);
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: 400;
    line-height: var(--leading-tight);
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .m-hero__sub {
    margin: 0 0 var(--space-6);
    max-width: 34rem;
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    color: var(--slate);
  }

  .m-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
  }

  .m-hero__secondary {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--slate);
    text-decoration: none;
    border-bottom: 1px solid var(--ghost-strong);
    padding-bottom: 0.1rem;
  }

  .m-hero__secondary:hover {
    color: var(--signal);
    border-color: var(--signal-mid);
  }

  .m-hero__secondary--quiet {
    font-weight: 400;
    border-bottom-style: dotted;
  }

  .m-hero__stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5) var(--space-7);
    margin: var(--space-6) 0 0;
    padding: 0;
  }

  .m-hero__stats div {
    min-width: 3.5rem;
  }

  .m-hero__stats dt {
    margin: 0 0 0.15rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--slate);
  }

  .m-hero__stats dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.65rem;
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--ink);
    line-height: 1;
  }

  .m-hero__micro {
    margin: var(--space-5) 0 0;
    font-size: var(--text-xs);
    color: var(--slate);
  }

  .m-hero__micro a {
    color: var(--slate);
  }

  .m-hero__micro a:hover {
    color: var(--signal);
  }

  .m-hero__featured {
    border: 1px solid var(--ghost);
    border-radius: 16px;
    background: color-mix(in srgb, var(--paper) 70%, white);
    padding: 1rem 1rem 0.75rem;
    box-shadow: 0 12px 40px rgba(26, 28, 34, 0.05);
    backdrop-filter: blur(8px);
  }

  .m-hero__featured-label {
    margin: 0 0 0.75rem;
    padding-inline: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--slate);
  }

  .m-hero__featured-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .m-hero__feat {
    display: grid;
    grid-template-columns: auto auto 1fr auto;
    align-items: center;
    gap: 0.65rem;
    padding: 0.65rem 0.55rem;
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    transition: background var(--duration) var(--ease);
  }

  .m-hero__feat:hover {
    background: color-mix(in srgb, var(--feat-accent) 10%, transparent);
    color: inherit;
  }

  .m-hero__feat-rank {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--slate);
    min-width: 1.25rem;
  }

  .m-hero__feat-mark {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 8px;
    background: color-mix(in srgb, var(--feat-accent) 16%, var(--paper));
    color: var(--feat-accent);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 500;
  }

  .m-hero__feat-body {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .m-hero__feat-name {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .m-hero__feat-meta {
    font-size: 0.7rem;
    color: var(--slate);
  }

  .m-hero__feat-go {
    color: var(--slate);
    opacity: 0.5;
    transition:
      opacity var(--duration) var(--ease),
      transform var(--duration) var(--ease);
  }

  .m-hero__feat:hover .m-hero__feat-go {
    opacity: 1;
    color: var(--signal);
    transform: translateX(2px);
  }

  .m-hero__glow {
    pointer-events: none;
    position: absolute;
    right: -8%;
    top: -5%;
    width: min(48rem, 80vw);
    height: min(48rem, 80vw);
    border-radius: 50%;
    background:
      radial-gradient(circle at 38% 42%, var(--honey-soft) 0%, transparent 52%),
      radial-gradient(circle at 62% 58%, var(--signal-soft) 0%, transparent 48%);
    opacity: 0.95;
  }

  @media (min-width: 900px) {
    .m-hero {
      padding-block: var(--space-9) var(--space-10);
    }
  }
</style>
